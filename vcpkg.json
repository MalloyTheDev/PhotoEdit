{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "photoedit",
  "version": "0.1.0",
  "description": "A flagship-level, Photoshop-class image editor (Windows first).",
  "homepage": "https://github.com/malloythedev/photoedit",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets",
        "gui",
        "png",
        "jpeg"
      ]
    },
    "lcms",
    "libpng",
    "libjpeg-turbo",
    "tiff",
    "libwebp",
    "zlib"
  ],
  "builtin-baseline": "0b88aacde46a853151730fbe7d0b7ee45f4b6864",
  "overrides": []
}
