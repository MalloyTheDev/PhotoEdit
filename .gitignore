# Build output. Anchored, so a source directory named "build" deeper in the tree is
# unaffected, but every sibling tree at the root (build-core, build-vs, ...) is covered.
/build*/
/out/
/cmake-build-*/
*.o
*.obj
*.exe
*.pdb
*.ilk

# vcpkg
/vcpkg_installed/
/vcpkg/

# IDE
/.vs/
/.vscode/
/.idea/
*.user
CMakeUserPresets.json

# Local convenience launchers. Machine-specific (they hardcode a toolchain path),
# so they stay out of the repository.
/run-*.bat

# OS
Thumbs.db
.DS_Store

# Qt
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
